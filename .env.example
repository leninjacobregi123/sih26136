# Copy to .env.local for local runs; add LLM_API_KEY and DATABASE_URL to Vercel for the deployed app.
LLM_API_KEY=        # Groq (gsk_...) or xAI (xai-...); provider is detected from the prefix
DATABASE_URL=       # Supabase transaction pooler, no password: postgresql://postgres.<ref>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_PASSWORD=  # the project's database password, as typed (no encoding needed)
SESSION_SECRET=     # 32+ random characters; signs the login cookie. Make one: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
